@model MotoMaintenanceTracker.Models.MaintenanceTask

@{
    ViewData["Title"] = "Task Details";
}

<h1>Maintenance Task Details</h1>

@{
    var reminder = ViewData["MaintenanceReminder"]
            as MotoMaintenanceTracker.Models.Message;
}

@if (reminder != null)
{
    <div class="alert @(reminder.IsDismissed? "alert-secondary" : "alert-warning") mt-3">
        <h5> @reminder.Title</h5>
        <p class="mb-2">@reminder.Content</p>

        @if(!reminder.IsDismissed)
        {
            <form asp-controller="Messages"
            asp-action="Dismiss"
            method="post">
        <input type="hidden" name="id" value="@reminder.Id" />
                <input type="hidden" name="returnUrl"
                       value="@Url.Action("Details", "MaintenanceTasks", new { id = Model.Id })" />
         <button type="submit" class="btn btn-warning btn-sm">
                    Dismiss reminder
                </button>
            </form>
        }
        else
        {
            <span class="badge bg-secondary">Dismissed</span>
        }
    </div>

}

<div>
    <hr />
    
    <dl class="row">
        <dt class="col-sm-3">Motorcycle</dt>
        <dd class="col-sm-9">
            @(Model.Motorcycle != null
                ? $"{Model.Motorcycle.Brand} {Model.Motorcycle.Model}"
                : "No motorcycle assigned")
        </dd>

        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">
            @(string.IsNullOrWhiteSpace(Model.Description)
                ? "—"
                : Model.Description)
        </dd>

        <dt class="col-sm-3">Due Date</dt>
        <dd class="col-sm-9">
            @(Model.DueDate.HasValue
                ? Model.DueDate.Value.ToShortDateString()
                : "Not scheduled")
        </dd>

        <dt class="col-sm-3">Due Mileage</dt>
        <dd class="col-sm-9">
            @(Model.DueMileage.HasValue
                ? Model.DueMileage.Value.ToString("N0") + " km"
                : "Not specified")
        </dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            @if (Model.IsCompleted)
            {
                <span class="badge bg-success">Completed</span>
            }
            else
            {
                <span class="badge bg-warning text-dark">Pending</span>
            }
        </dd>
    </dl>
    
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
