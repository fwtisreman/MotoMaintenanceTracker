@model MotoMaintenanceTracker.Models.ServiceRecord

@{
    ViewData["Title"] = "Delete Service Record";
}

<h1>Delete Service Record</h1>

<h3>Are you sure you want to delete this record?</h3>

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Motorcycle</dt>
        <dd class="col-sm-10">
            @(Model.Motorcycle?.Model ?? "Unknown")
        </dd>

        <dt class="col-sm-2">Service Type</dt>
        <dd class="col-sm-10">@Model.ServiceType</dd>

        <dt class="col-sm-2">Service Date</dt>
        <dd class="col-sm-10">
            @Model.ServiceDate.ToShortDateString()
        </dd>

        <dt class="col-sm-2">Mileage</dt>
        <dd class="col-sm-10">@Model.Mileage km</dd>

        <dt class="col-sm-2">Cost</dt>
        <dd class="col-sm-10">@Model.Cost.ToString("F2")</dd>

        <dt class="col-sm-2">Notes</dt>
        <dd class="col-sm-10">
            @(string.IsNullOrWhiteSpace(Model.Notes)
                ? "No notes"
                : Model.Notes)
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
