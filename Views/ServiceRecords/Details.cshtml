@model MotoMaintenanceTracker.Models.ServiceRecord

@{
    ViewData["Title"] = "Service Record Details";
}

<h1>Service Record Details</h1>

<div>
    <h4>Service Record</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            Motorcycle
        </dt>
        <dd class="col-sm-10">
            @(Model.Motorcycle?.Model ?? "Unknown")
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ServiceType)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ServiceType)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ServiceDate)
        </dt>
        <dd class="col-sm-10">
            @Model.ServiceDate.ToString("dd/MM/yyyy")
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Mileage)
        </dt>
        <dd class="col-sm-10">
            @Model.Mileage.ToString("N0") km
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Cost)
        </dt>
        <dd class="col-sm-10">
            @Model.Cost.ToString("F2")
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Notes)
        </dt>
        <dd class="col-sm-10">
            @(string.IsNullOrWhiteSpace(Model.Notes) ? "No notes" : Model.Notes)
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
